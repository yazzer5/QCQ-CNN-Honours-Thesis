#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════
# v15.8: one job. Protocol = v15.5 exactly (N=500, w15, CE, linear head, deterministic,
# val 125/class, test 200/class, 200 epochs max, patience 20, warmup 30 for M3/M5, 0 for
# M4/M6). Same V155 pixel noise. The only addition: --model M6 (fixed cos(pi x) front-end).
#   qsub -v K,TAG,SG,MODEL,SEED,OUT,CONT   (submit scripts set the name)
# ═══════════════════════════════════════════════════════════════════════
#PBS -P wa66
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/wa66
#PBS -l wd
#PBS -N v158
#PBS -j oe

set -e
: "${K:?}" "${TAG:?}" "${SG:?}" "${MODEL:?}" "${SEED:?}" "${OUT:?}"
CONT="${CONT:-0}"

cd "$PBS_O_WORKDIR"
JOB_MODEL="$MODEL"                       # v13.5 D1: never let a sourced file overwrite MODEL
source ./config158.sh
MODEL="$JOB_MODEL"
CLASSES=$(subset_classes "$K" "$TAG") || { echo "FATAL: unknown subset K=$K TAG=$TAG"; exit 1; }
N_TRAIN=$((N_PER_CLASS * K)); N_VAL=$((PER_CLASS_VAL * K)); N_TEST=$((PER_CLASS_TEST * K))
[ "$OUT" = "$(out_dir "$K" "$TAG" "$SG")" ] || { echo "FATAL: OUT=$OUT does not match K/TAG/SIGMA"; exit 1; }

cd "$PBS_O_WORKDIR/.."
REPO=$(pwd)
ls -l train_gadi.py quanv_torch.py qnn_torch.py || { echo "FATAL: repo root not found"; exit 1; }
grep -q "V13_READOUT_PATCH" qnn_torch.py    || { echo "FATAL: qnn_torch.py is not the v13-patched file"; exit 1; }
grep -q "V135_M5_PATCH" train_gadi.py       || { echo "FATAL: train_gadi.py lacks the v13.5 M5 patch"; exit 1; }
grep -q "V14_SPLIT_AUDIT" train_gadi.py     || { echo "FATAL: train_gadi.py lacks the v14 split audit"; exit 1; }
grep -q "V155_INPUT_NOISE" train_gadi.py    || { echo "FATAL: train_gadi.py is not the v15.5-patched file"; exit 1; }
grep -q "V158_M6_COS" train_gadi.py         || { echo "FATAL: train_gadi.py is not the v15.8-patched file"; exit 1; }
case "$MODEL" in M3|M4|M5|M6) ;; *) echo "FATAL: model $MODEL not in v15.8"; exit 1 ;; esac
if grep -q "V15_FE_NOISE" train_gadi.py; then echo "FATAL: train_gadi.py carries the v15 circuit-noise patch"; exit 1; fi
unset V14_NO_AUDIT V14_SPLIT_ONLY V14_SPLIT_DUMP V15_ALPHA V15_CALIB V15_EVAL_ALPHAS

module load cuda/11.7.0
source ${CONDA_SH:-/g/data/wa66/yh2481/miniconda3/etc/profile.d/conda.sh}
conda activate qcqcnn
export PYTHONPATH=""
export CUBLAS_WORKSPACE_CONFIG=:4096:8      # before torch makes its cuBLAS handle (v10 D3)
export V155_SIGMA="$SG" V155_EVAL_SIGMAS="$EVAL_SIGMAS" V155_EVAL_SP="$EVAL_SP"

echo "=== Job start: $(date) ==="
echo "[V158] K=$K TAG=$TAG SIGMA=$SG CLASSES=$CLASSES MODEL=$MODEL SEED=$SEED OUT=$OUT CONT=$CONT"
echo "[V158] split train=$N_TRAIN val=$N_VAL test=$N_TEST budget=${BUDGET}h eval_sigmas=[$EVAL_SIGMAS] eval_sp=[$EVAL_SP]"

python scripts/preflight_data.py --data_root ./data --dataset mnist \
    --classes "$CLASSES" --n_train $N_TRAIN --n_val $N_VAL --n_test $N_TEST \
    || { echo "FATAL: data preflight failed -- not training"; exit 1; }

set +e
python train_gadi.py \
    --model "$MODEL" --dataset mnist --classes "$CLASSES" --seed "$SEED" \
    --noise_alpha 0.0 --n_obs "$W_OBS" --head_variant linear --loss ce \
    --deterministic --save_predictions \
    --n_train $N_TRAIN --n_val $N_VAL --n_test $N_TEST \
    --max_epochs $MAX_EPOCHS --patience $PATIENCE \
    --output_dir "./$OUT" --data_root ./data \
    --checkpoint_dir "./ckpt_${OUT#results_}_${MODEL}_r${SEED}" \
    --time_budget_hours "$BUDGET"
RC=$?
set -e

if [ $RC -eq 99 ]; then
  if [ "$CONT" -ge 3 ]; then echo "=== FATAL: time budget hit $CONT times ==="; echo "=== Job end: $(date) rc=99 ==="; exit 1; fi
  echo "Time budget reached -- continuation $((CONT+1))/3. NOT bit-reproducible: flag it."
  cd "$PBS_O_WORKDIR"
  qsub -N "${PBS_JOBNAME}" -v K=$K,TAG=$TAG,SG=$SG,MODEL=$MODEL,SEED=$SEED,OUT=$OUT,CONT=$((CONT+1)) run158.pbs
  echo "=== Job end: $(date) rc=99 (continued) ==="
  exit 0
fi
if [ $RC -eq 0 ] && grep -q '"selfcheck": "MATCH"' "./$OUT/v155_xeval_${MODEL}_seed${SEED}.json" 2>/dev/null; then
  rm -rf "./ckpt_${OUT#results_}_${MODEL}_r${SEED}"
  echo "[V158] checkpoint dir removed after a MATCH cross-eval (inode budget, v15 amendment A1)"
fi
echo "=== Job end: $(date) rc=$RC ==="
exit $RC
