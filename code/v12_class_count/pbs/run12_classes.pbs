#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════
# v12 -- MNIST class-count sweep, ONE job = one (K, subset, model, seed).
# Protocol is v10's exactly (CE loss, n_obs=3, linear head, deterministic,
# 500/125/200 per class, 200 epochs, patience 20) -- only the classes change.
#
# Variables passed with qsub -v:  K, TAG, MODEL, SEED, CONT
#
# NOTE: the [PROTOCOL] REDUCED-SCALE banner WILL fire (split sizes and
# epochs are passed explicitly). That is expected, same as v10. The
# integrity gate reads [PROTOCOL RESOLVED], printed by train_gadi.py from
# its resolved variables.
#
# CHECK BEFORE FIRST SUBMIT: the #PBS resource lines below must match the
# ones in the v10 grid PBS that ran clean. README step 3 diffs them.
# ═══════════════════════════════════════════════════════════════════════
#PBS -P wa66
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/wa66
#PBS -l wd
#PBS -N v12_cls
#PBS -j oe

set -e
: "${K:?K not set}" "${TAG:?TAG not set}" "${MODEL:?MODEL not set}" "${SEED:?SEED not set}"
CONT="${CONT:-0}"

cd "$PBS_O_WORKDIR"
source ./subsets.sh
CLASSES=$(subset_classes "$K" "$TAG") || { echo "FATAL: unknown subset K=$K TAG=$TAG"; exit 1; }
OUT=$(results_dir "$K" "$TAG")
N_TRAIN=$((PER_CLASS_TRAIN * K))
N_VAL=$((PER_CLASS_VAL * K))
N_TEST=$((PER_CLASS_TEST * K))

cd "$PBS_O_WORKDIR/.."
echo "PWD=$(pwd)"
ls -l train_gadi.py quanv_torch.py qnn_torch.py || { echo "FATAL: repo root not found"; exit 1; }

module load cuda/11.7.0
source /g/data/wa66/yh2481/miniconda3/etc/profile.d/conda.sh
conda activate qcqcnn
export PYTHONPATH=""
# Must be set BEFORE torch creates its cuBLAS handle (v10 defect D3).
export CUBLAS_WORKSPACE_CONFIG=:4096:8

echo "=== Job start: $(date) ==="
echo "[V12] K=$K TAG=$TAG CLASSES=$CLASSES MODEL=$MODEL SEED=$SEED CONT=$CONT"
echo "[V12] split train=$N_TRAIN val=$N_VAL test=$N_TEST out=$OUT"

python scripts/preflight_data.py --data_root ./data --dataset mnist \
    --classes "$CLASSES" --n_train $N_TRAIN --n_val $N_VAL --n_test $N_TEST \
    || { echo "FATAL: data preflight failed -- not training"; exit 1; }

set +e
python train_gadi.py \
    --model "$MODEL" \
    --dataset mnist \
    --classes "$CLASSES" \
    --seed "$SEED" \
    --noise_alpha 0.0 \
    --n_obs 3 \
    --head_variant linear \
    --loss ce \
    --deterministic \
    --save_predictions \
    --n_train $N_TRAIN \
    --n_val $N_VAL \
    --n_test $N_TEST \
    --max_epochs 200 \
    --patience 20 \
    --output_dir "./$OUT" \
    --data_root ./data \
    --checkpoint_dir "./ckpt_v12_k${K}_${TAG}" \
    --time_budget_hours 0.75
RC=$?
set -e

if [ $RC -eq 99 ]; then
    # Continuation cap (carried from v10). Should never fire: fewer classes
    # means less data per epoch than v10's ~20 min jobs.
    if [ "$CONT" -ge 3 ]; then
        echo "=== FATAL: hit the time budget $CONT times. NOT resubmitting. ==="
        echo "=== Job end: $(date) rc=99 ==="
        exit 1
    fi
    echo "Time budget reached -- continuation $((CONT+1))/3. NOT bit-reproducible: flag it."
    cd "$PBS_O_WORKDIR"
    qsub -v K=$K,TAG=$TAG,MODEL=$MODEL,SEED=$SEED,CONT=$((CONT+1)) run12_classes.pbs
    exit 0
fi
echo "=== Job end: $(date) rc=$RC ==="
exit $RC
