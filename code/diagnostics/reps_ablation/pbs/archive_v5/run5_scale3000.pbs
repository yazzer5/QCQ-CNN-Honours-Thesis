#!/bin/bash
#PBS -N v5_s3000
#PBS -P wa66
#PBS -q gpuvolta
#PBS -l walltime=01:00:00
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l jobfs=10GB
#PBS -l storage=gdata/wa66
#PBS -v MODEL=M2,DATASET=mnist,SEED=42,DROPOUT=0.0

# ═══════════════════════════════════════════════════════════════════════
# SCALE-3000 RUN — 3000/750/600, seed 42, all four models.
#
# Final rehearsal before the locked full protocol (5000/1250/1000). Same
# 1 : 0.25 : 0.2 split ratio as the full protocol, so only the sample
# count changes.
#
# SCHEDULE PARAMETERS — scaled by OPTIMISER UPDATES, not epochs, because
# that is what the quantum back-end's plateau actually depends on. The
# plateau has consistently broken at ~180 updates:
#     n=500   15 steps/epoch -> predicted epoch 12, observed 11-13  ✓
#     n=1000  31 steps/epoch -> predicted epoch  6, observed  6     ✓
#     n=3000  94 steps/epoch -> predicted epoch  2
#     n=5000 156 steps/epoch -> predicted epoch  1-2
#   --min_epochs_quantum 10   5x margin over the predicted epoch-2 exit
#                             (was 15 at n=1000, where the exit was epoch 6)
#   --patience 10             unchanged from the locked protocol
#   --max_epochs 50           M2 early-stopped at epoch 31 at both n=500 and
#                             n=1000; at 3x the updates per epoch of n=1000,
#                             expect convergence around epoch 10-15, so 50
#                             is generous headroom
#   batch size 32, dropout 0.0, weight_decay 1e-4 (all locked defaults)
#
# WALLTIME: with --qnn_backend torch (the default) M2 should run ~1-3
# s/epoch, so the whole thing is minutes. If you override to
# --qnn_backend qiskit it becomes ~48 s/epoch (3x the 16.1 s/epoch measured
# at n=1000), i.e. ~40 min for 50 epochs -- still inside the 1h wall, but
# without much margin. Do not add the qiskit override casually here.
#
# STILL A REDUCED-SCALE RUN -- train_gadi.py tags it REDUCED-SCALE in the
# result JSON. Do not mix with full-protocol results.
# ═══════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════

set -e
cd "$PBS_O_WORKDIR/.."
echo "PWD=$(pwd)"
ls -l train_gadi.py quanv_torch.py || { echo "FATAL: repo root not found"; exit 1; }

module load cuda/11.7.0
source /g/data/wa66/yh2481/miniconda3/etc/profile.d/conda.sh
conda activate qcqcnn
export PYTHONPATH=""

echo "=== Job start: $(date) ==="
echo "MODEL=$MODEL DATASET=$DATASET SEED=$SEED DROPOUT=${DROPOUT:-0.0} (SCALE-3000)"
nvidia-smi --query-gpu=name,memory.total --format=csv

nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used \
    --format=csv -l 2 > gpu_util_v5s3000_${MODEL}_${DATASET}_s${SEED}_d${DROPOUT:-0.0}.csv &
NVSMI_PID=$!

python train_gadi.py \
    --model "$MODEL" \
    --dataset "$DATASET" \
    --seed "$SEED" \
    --noise_alpha 0.0 \
    --output_dir ./results_v5_scale3000 \
    --data_root ./data \
    --n_train 3000 --n_val 750 --n_test 600 \
    --max_epochs 50 \
    --min_epochs_quantum 10 \
    --patience 10 \
    --dropout "${DROPOUT:-0.0}"

kill $NVSMI_PID 2>/dev/null || true
echo "=== Job end: $(date) ==="
echo "Peak GPU util:"
awk -F, 'NR>1{gsub(/[^0-9]/,"",$2); if($2+0>m) m=$2+0} END{print m"%"}' \
    gpu_util_v5s3000_${MODEL}_${DATASET}_s${SEED}_d${DROPOUT:-0.0}.csv
